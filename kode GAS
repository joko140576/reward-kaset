/**
 * Redeem Point - Perbaikan Kaset CRM
 * Backend Google Apps Script
 */
const SHEET_NAME = 'Redeem';
const SPREADSHEET_ID = ''; // kosongkan jika script dibuat dari Extensions > Apps Script di dalam spreadsheet
const HEADERS = ['Timestamp', 'Nama', 'NPP', 'Region', 'TWU', 'Jenis Kaset',
                 'Tanggal Perbaikan', 'Tanggal Selesai', 'Status', 'Point',
                 'Kondisi Awal', 'Part Diganti', 'Pengujian Checker', 'Pengujian Mesin', 'Foto'];
const POINT_OK = 10;
const KASET = ['Hitachi SR7500', 'Hitachi VS 7500', 'RG-7', 'RG-8',
               'Hyosung MX8600', 'Hyosung MX8600-S', 'DN'];
const STATUS = ['OK', 'Pending Part', 'Unrepair'];
const KONDISI = ['Indikasi human error', 'Part rusak', 'Mekanik problem', 'Lain-lain'];
const PART = ['Handle', 'Casing', 'Unit kunci', 'Spacer unit', 'Motor unit', 'Sensor',
              'Belt', 'Board', 'Mekanik lainnya', 'Tidak ada part diganti'];
const HASIL = ['Berhasil', 'Belum berhasil'];
const MAX_FOTO = 2 * 1024 * 1024;
const FOLDER_ID = '1fPYE6aeoc7RRzXRKu9MMgGuHDrn0Tvop'; // folder Drive tujuan foto

// ===== API JSON (dipanggil dari index.html lewat URL /exec) =====
function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// GET  : ?action=points  -> daftar point status OK
function doGet(e) {
  try {
    const action = e && e.parameter ? e.parameter.action : '';
    if (action === 'points') return json_({ ok: true, data: getPoints() });
    return json_({ ok: true, message: 'API Redeem Point aktif' });
  } catch (err) {
    return json_({ ok: false, error: String(err.message || err) });
  }
}

// POST : body JSON (dikirim sebagai text/plain agar bebas CORS preflight)
function doPost(e) {
  try {
    const d = JSON.parse(e.postData.contents);
    return json_(saveData(d));
  } catch (err) {
    return json_({ ok: false, error: String(err.message || err) });
  }
}

function getSheet_() {
  const ss = SPREADSHEET_ID
    ? SpreadsheetApp.openById(SPREADSHEET_ID)
    : SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET_NAME);
  if (!sh) sh = ss.insertSheet(SHEET_NAME);
  // isi header jika sheet kosong, atau kolom baru (K-O) belum punya header
  if (sh.getLastRow() === 0 || !sh.getRange(1, HEADERS.length).getValue()) {
    sh.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS])
      .setFontWeight('bold').setBackground('#e8eefc');
    sh.setFrozenRows(1);
  }
  return sh;
}

function saveFoto_(d, nama) {
  if (!d.foto || !/^image\//.test(d.fotoType || '')) throw new Error('Foto perbaikan tidak valid.');
  const bytes = Utilities.base64Decode(d.foto);
  if (bytes.length > MAX_FOTO) throw new Error('Ukuran foto melebihi 2 MB.');

  let folder;
  if (FOLDER_ID) folder = DriveApp.getFolderById(FOLDER_ID);
  else {
    const it = DriveApp.getFoldersByName('Foto Redeem CRM');
    folder = it.hasNext() ? it.next() : DriveApp.createFolder('Foto Redeem CRM');
  }
  const ext = d.fotoType.split('/')[1].replace('jpeg', 'jpg');
  const fname = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyyMMdd_HHmmss') +
                '_' + nama.replace(/[^\w]+/g, '_') + '.' + ext;
  const file = folder.createFile(Utilities.newBlob(bytes, d.fotoType, fname));
  try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) {}
  return file.getUrl();
}

function saveData(d) {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const nama = String(d.nama || '').trim();
    const npp = String(d.npp || '').trim();
    const region = Number(d.region);
    const twu = String(d.twu || '').trim();
    if (!nama || !npp || !twu) throw new Error('Nama, NPP, dan TWU wajib diisi.');
    if (!(region >= 1 && region <= 10)) throw new Error('Region harus 1 sampai 10.');
    if (KASET.indexOf(d.kaset) < 0) throw new Error('Jenis kaset tidak valid.');
    if (KONDISI.indexOf(d.kondisi) < 0) throw new Error('Kondisi awal tidak valid.');
    if (PART.indexOf(d.part) < 0) throw new Error('Part yang diganti tidak valid.');
    if (HASIL.indexOf(d.checker) < 0) throw new Error('Pengujian checker tidak valid.');
    if (HASIL.indexOf(d.mesin) < 0) throw new Error('Pengujian di mesin tidak valid.');
    if (STATUS.indexOf(d.status) < 0) throw new Error('Status tidak valid.');
    if (!d.tglPerbaikan || !d.tglSelesai) throw new Error('Tanggal wajib diisi.');
    if (d.tglSelesai < d.tglPerbaikan) throw new Error('Tanggal selesai tidak boleh sebelum tanggal perbaikan.');

    const fotoUrl = saveFoto_(d, nama); // upload dulu; kalau gagal, data tidak tersimpan

    const point = d.status === 'OK' ? POINT_OK : 0;
    const sh = getSheet_();
    const r = sh.getLastRow() + 1;
    // NPP & tanggal disimpan sebagai teks agar tidak berubah format
    sh.getRange(r, 2, 1, 1).setNumberFormat('@');
    sh.getRange(r, 3, 1, 1).setNumberFormat('@');
    sh.getRange(r, 7, 1, 2).setNumberFormat('@');
    sh.getRange(r, 1, 1, HEADERS.length).setValues([[
      new Date(), nama, npp, region, twu, d.kaset,
      d.tglPerbaikan, d.tglSelesai, d.status, point,
      d.kondisi, d.part, d.checker, d.mesin, fotoUrl
    ]]);
    CacheService.getScriptCache().remove('points'); // data baru -> cache dihapus
    return { ok: true, point: point };
  } finally {
    lock.releaseLock();
  }
}

function getPoints() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('points');
  if (hit) return JSON.parse(hit); // cepat: dari cache

  const sh = getSheet_();
  const last = sh.getLastRow();
  let out = [];
  if (last >= 2) {
    // baca hanya kolom B..J (bukan seluruh sheet)
    const rows = sh.getRange(2, 2, last - 1, 9).getValues();
    out = rows
      .filter(function (r) { return r[7] === 'OK'; })
      .map(function (r) {
        return { nama: r[0], npp: String(r[1]), region: r[2], twu: r[3], status: r[7], point: r[8] };
      });
  }
  try { cache.put('points', JSON.stringify(out), 300); } catch (e) {}
  return out;
}

// Jalankan SEKALI dari editor (pilih authDrive > Run) untuk memberi izin Drive penuh
function authDrive() {
  const f = DriveApp.createFile('tes-izin.txt', 'tes');
  f.setTrashed(true);
  DriveApp.getFolderById(FOLDER_ID); // cek akses ke folder tujuan
}
