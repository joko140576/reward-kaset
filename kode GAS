/**
 * Redeem Point - Perbaikan Kaset CRM
 * Backend Google Apps Script
 */
const SHEET_NAME = 'Redeem';
const SPREADSHEET_ID = ''; // kosongkan jika script dibuat dari Extensions > Apps Script di dalam spreadsheet
const HEADERS = ['Timestamp', 'Nama', 'NPP', 'Region', 'TWU', 'Jenis Kaset',
                 'Tanggal Perbaikan', 'Tanggal Selesai', 'Status', 'Point'];
const POINT_OK = 10;
const KASET = ['Hitachi SR7500', 'Hitachi VS 7500', 'RG-7', 'RG-8',
               'Hyosung MX8600', 'Hyosung MX8600-S', 'DN'];
const STATUS = ['OK', 'Pending Part', 'Unrepair'];

// ===== API JSON (dipanggil dari index.html lewat URL /exec) =====
function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// GET  : ?action=points  -> daftar point status OK
function doGet(e) {
  try {
    const action = e && e.parameter ? e.parameter.action : '';
    if (action === 'points') return json_({ ok: true, data: getPoints() });
    return json_({ ok: true, message: 'API Redeem Point aktif' });
  } catch (err) {
    return json_({ ok: false, error: String(err.message || err) });
  }
}

// POST : body JSON (dikirim sebagai text/plain agar bebas CORS preflight)
function doPost(e) {
  try {
    const d = JSON.parse(e.postData.contents);
    return json_(saveData(d));
  } catch (err) {
    return json_({ ok: false, error: String(err.message || err) });
  }
}

function getSheet_() {
  const ss = SPREADSHEET_ID
    ? SpreadsheetApp.openById(SPREADSHEET_ID)
    : SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET_NAME);
  if (!sh) sh = ss.insertSheet(SHEET_NAME);
  if (sh.getLastRow() === 0) {
    sh.appendRow(HEADERS);
    sh.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold').setBackground('#e8eefc');
    sh.setFrozenRows(1);
  }
  return sh;
}

function saveData(d) {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const nama = String(d.nama || '').trim();
    const npp = String(d.npp || '').trim();
    const region = Number(d.region);
    const twu = String(d.twu || '').trim();
    if (!nama || !npp || !twu) throw new Error('Nama, NPP, dan TWU wajib diisi.');
    if (!(region >= 1 && region <= 10)) throw new Error('Region harus 1 sampai 10.');
    if (KASET.indexOf(d.kaset) < 0) throw new Error('Jenis kaset tidak valid.');
    if (STATUS.indexOf(d.status) < 0) throw new Error('Status tidak valid.');
    if (!d.tglPerbaikan || !d.tglSelesai) throw new Error('Tanggal wajib diisi.');
    if (d.tglSelesai < d.tglPerbaikan) throw new Error('Tanggal selesai tidak boleh sebelum tanggal perbaikan.');

    const point = d.status === 'OK' ? POINT_OK : 0;
    const sh = getSheet_();
    const r = sh.getLastRow() + 1;
    // NPP & tanggal disimpan sebagai teks agar tidak berubah format
    sh.getRange(r, 2, 1, 1).setNumberFormat('@');
    sh.getRange(r, 3, 1, 1).setNumberFormat('@');
    sh.getRange(r, 7, 1, 2).setNumberFormat('@');
    sh.getRange(r, 1, 1, HEADERS.length).setValues([[
      new Date(), nama, npp, region, twu, d.kaset,
      d.tglPerbaikan, d.tglSelesai, d.status, point
    ]]);
    return { ok: true, point: point };
  } finally {
    lock.releaseLock();
  }
}

function getPoints() {
  const sh = getSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const rows = sh.getRange(2, 1, last - 1, HEADERS.length).getValues();
  return rows
    .filter(function (r) { return r[8] === 'OK'; })
    .map(function (r) {
      return { nama: r[1], npp: String(r[2]), region: r[3], twu: r[4], status: r[8], point: r[9] };
    });
}
